# Narasi Media Environment Configuration
PORT=8080
RUST_LOG=info

# Upstream SMM Provider API Credentials
SMM_PROVIDER_URL=https://smmprovider.com/api/v2
SMM_PROVIDER_KEY=your_upstream_api_key_here

# Payment Gateway (Optional - for automated modes)
