# Caddy Reverse Proxy with Auto-HTTPS (Let's Encrypt)

# Client Web App Domain
narasi.domain.com {
    reverse_proxy narasi-web:80
}

# Admin Panel Subdomain
admin.narasi.domain.com {
    reverse_proxy narasi-admin:80
}

# Backend API Subdomain
api.narasi.domain.com {
    reverse_proxy narasi-backend:8080
}
