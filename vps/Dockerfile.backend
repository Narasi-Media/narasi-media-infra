# Multi-stage optimized Rust build
FROM rust:1.80-slim as builder
WORKDIR /app
COPY . .
RUN cargo build --release --bin buzzer-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/buzzer-server /app/buzzer-server
ENV PORT=8080
EXPOSE 8080
CMD ["/app/buzzer-server"]
